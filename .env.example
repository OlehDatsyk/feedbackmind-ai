# FeedbackMind AI - example configuration. Copy to ".env" (never commit .env).
# "Start App.bat" / "Start App (Mac).command" create .env from this file with random secrets automatically.

# --- Core -------------------------------------------------------------------
ENVIRONMENT=development                 # development | production
SECRET_KEY=change-me-to-a-long-random-string   # JWT signing key, min 32 chars in production
DATABASE_URL=postgresql+psycopg://feedbackmind:feedbackmind@127.0.0.1:5436/feedbackmind
FRONTEND_URL=http://localhost:5173      # used to build invitation links
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14
REGISTRATION_ENABLED=true
DOCS_ENABLED=true                       # serve OpenAPI docs at /api/docs

# Fernet key used to encrypt stored secrets (webhook signing secrets, workspace AI keys).
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# --- AI (optional) ----------------------------------------------------------
# none | anthropic | openai | gemini. Without a provider, the app uses its rule-based analyser and says so.
AI_PROVIDER=none
AI_MODEL=                               # default for anthropic: claude-opus-5-5; set explicitly for openai/gemini
AI_EFFORT=medium                        # anthropic effort: low | medium | high
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
AI_DAILY_TOKEN_LIMIT=2000000            # per workspace per 24 h, 0 = unlimited
AI_MAX_RECORDS_PER_RUN=500
AI_BATCH_SIZE=20

# --- Imports & background jobs ------------------------------------------------
MAX_IMPORT_MB=20
MAX_IMPORT_ROWS=100000
EMBEDDED_WORKER=true                    # run the job worker inside the API; false if you run "python -m app.worker"
WORKER_CONCURRENCY=1
ALERT_EVAL_INTERVAL_MINUTES=30

# --- Frontend (build time, public - never put secrets in VITE_* variables) ----
# VITE_API_URL=https://your-api.example.com   # empty = same origin (Vite dev proxy)
